// Resolve the Phoenix JavaScript clients from the packages installed by Mix.
{
  "compilerOptions": {
    "baseUrl": ".",
    "paths": {
      "phoenix": ["../deps/phoenix"],
      "phoenix_html": ["../deps/phoenix_html"],
      "phoenix_live_view": ["../deps/phoenix_live_view"]
    },
    "allowJs": true,
    "noEmit": true
  },
  "include": [
    "js/**/*"
  ]
}
